# ─────────────────────────────────────────────────────────────────────────────
# RSC Classroom: environment
# Run `npm run setup` to generate a real .env with strong random secrets.
# Never commit .env. Every port here is deliberately NON-standard.
# ─────────────────────────────────────────────────────────────────────────────

APP_URL=http://localhost:4310

# Ports (localhost only)
WEB_PORT=4310
WORKER_PORT=4311
STUDIO_PORT=4312
DB_PORT=54329
REDIS_PORT=63790
SMTP_PORT=10250
MAILPIT_UI_PORT=10251

# Database (Docker service "postgres")
DB_USER=rsc
DB_NAME=rsc_classroom
DB_PASSWORD=change-me
DATABASE_URL=postgresql://rsc:change-me@127.0.0.1:54329/rsc_classroom?schema=public

# Redis (Docker service "redis"); used by the job queue
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:63790

# Cryptography: 32 random bytes, base64. Losing ENCRYPTION_KEY = losing encrypted data.
ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# One-time token required to create the Owner account at /setup
SETUP_TOKEN=

# Sessions
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
# Secure cookies: always true in production (requires HTTPS)
COOKIE_SECURE=false
# Force 2FA for every login: always true in production
REQUIRE_2FA=false

# Emails allowed to use Edit mode (modify every record). Must also be the Owner account.
FULL_EDIT_EMAILS=

# Outgoing email. Leave MAIL_HOST unset to use the local Mailpit test inbox.
# Live with Gmail: needs 2-Step Verification + an App password (myaccount.google.com/apppasswords)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_USER=you@gmail.com
# MAIL_PASSWORD=abcd efgh ijkl mnop
# MAIL_FROM_NAME=Rahul Shah Classes

# WhatsApp: test = logged only (Messages page). cloud = official WhatsApp Business Cloud API.
# test   = record only, nothing sent
# manual = no Meta setup: Messages page gives a one-click "Open WhatsApp" link per message, you press Send
# cloud  = official WhatsApp Business Cloud API (needs the Meta values below)
WHATSAPP_MODE=test
# WHATSAPP_TOKEN=            (permanent System User token from Meta Business settings)
# WHATSAPP_PHONE_NUMBER_ID=  (WhatsApp Manager > API setup > Phone number ID)
# WHATSAPP_TEMPLATE=timetable_update
# WHATSAPP_TEMPLATE_LANG=en

# ---- Exam Prep module (separate database; nothing shared with the classroom) ----
EXAM_PREP_ENABLED=true
EXAM_PREP_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:54329/rsc_exam_prep?schema=public
EXAM_PREP_TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:54329/rsc_exam_prep_test?schema=public
EXAM_PREP_SECRET=generate-64-hex-chars
