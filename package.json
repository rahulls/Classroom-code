{
  "name": "rsc-classroom",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "postinstall": "prisma generate && prisma generate --schema prisma/exam-prep/schema.prisma",
    "setup": "node scripts/setup-env.mjs",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "node scripts/run.mjs studio",
    "dev": "node scripts/run.mjs dev",
    "build": "next build",
    "start": "node scripts/run.mjs start",
    "typecheck": "tsc --noEmit",
    "gen:actions": "node scripts/gen-actions.mjs",
    "app": "next build && node scripts/run.mjs start",
    "exam-prep:generate": "prisma generate --schema prisma/exam-prep/schema.prisma",
    "exam-prep:migrate": "node scripts/exam-prep-migrate.mjs",
    "exam-prep:seed": "tsx --conditions=react-server src/modules/exam-prep/seed/seed.ts",
    "test:exam-prep": "vitest run --config src/modules/exam-prep/vitest.config.mts",
    "exam-prep:gen-actions": "node scripts/exam-prep-gen-actions.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "libphonenumber-js": "1.13.15",
    "next": "15.5.28",
    "nodemailer": "10.1.7",
    "otplib": "12.0.1",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "playwright-core": "1.64.1",
    "postcss": "8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "deepmerge-ts": "8.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
